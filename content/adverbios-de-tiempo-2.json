{
  "tema": "adverbios-de-tiempo-2",
  "titulo": "Ya, todavía, aún",
  "descripcion_gramatical": "Adverbios de tiempo (2)",
  "ejercicios": [
    {
      "tipologia": "T3",
      "enunciado": "Complete the sentences with *todavía*, *aún*, or *ya no*.",
      "items": [
        {
          "texto_enunciado": "No puedes irte. _____ te necesito.",
          "solucion_correcta": [
            "Todavía/Aún"
          ]
        },
        {
          "texto_enunciado": "—¿Está Berta? —No, _____ vive aquí.",
          "solucion_correcta": [
            "ya no"
          ]
        },
        {
          "texto_enunciado": "—¿Sigues jugando al tenis? —Sí, _____ juego de vez en cuando.",
          "solucion_correcta": [
            "todavía/aún"
          ]
        },
        {
          "texto_enunciado": "—¿Vas a la oficina? —No, _____ estoy de vacaciones.",
          "solucion_correcta": [
            "todavía/aún"
          ]
        },
        {
          "texto_enunciado": "Puedes irte. _____ te necesito.",
          "solucion_correcta": [
            "Ya no"
          ]
        },
        {
          "texto_enunciado": "—¿Me dejas la bici, Manuel? —Lo siento, _____ tengo bici. Se me rompió.",
          "solucion_correcta": [
            "ya no"
          ]
        },
        {
          "texto_enunciado": "—¿Sigue estudiando griego? —Sí, _____ lo estudio. Me encanta.",
          "solucion_correcta": [
            "todavía/aún"
          ]
        }
      ]
    },
    {
      "tipologia": "T12",
      "enunciado": "Read the answers and write the questions.",
      "items": [
        {
          "texto_enunciado": "—¿_____? —Sí, ya nos conocemos.",
          "solucion_correcta": [
            "¿Se conocen ya ustedes?"
          ]
        },
        {
          "texto_enunciado": "—¿_____? —Sí, ya lo sé.",
          "solucion_correcta": [
            "¿Lo sabes ya?/¿Ya lo sabes?"
          ]
        },
        {
          "texto_enunciado": "—¿_____? —No, aún no ha llegado Paloma.",
          "solucion_correcta": [
            "¿Ha llegado ya Paloma?"
          ]
        },
        {
          "texto_enunciado": "—¿_____? —No, todavía no hemos empezado las clases.",
          "solucion_correcta": [
            "¿Han empezado ya las clases?"
          ]
        },
        {
          "texto_enunciado": "—¿_____? —No, la comida no está lista todavía.",
          "solucion_correcta": [
            "¿Está lista ya la comida?/¿Está ya lista la comida?"
          ]
        }
      ]
    },
    {
      "tipologia": "T3",
      "enunciado": "Complete the sentences with *ya*, *todavía no* / *aún no*.",
      "items": [
        {
          "texto_enunciado": "Estoy esperando a Lidia desde las seis, pero _____ ha llegado.",
          "solucion_correcta": [
            "todavía no/aún no"
          ]
        },
        {
          "texto_enunciado": "Venid. _____ han abierto las puertas.",
          "solucion_correcta": [
            "Ya"
          ]
        },
        {
          "texto_enunciado": "—¿Qué quieres estudiar? —_____ lo sé.",
          "solucion_correcta": [
            "Todavía no/Aún no"
          ]
        },
        {
          "texto_enunciado": "—¿Sabes que Lorenzo se marcha a Chile? —Sí, _____ lo sé.",
          "solucion_correcta": [
            "ya"
          ]
        },
        {
          "texto_enunciado": "—¿Has leído _____ el fichero que te mandé? —No, _____ lo he abierto.",
          "solucion_correcta": [
            "Ya",
            "todavía no/aún no"
          ]
        },
        {
          "texto_enunciado": "¿_____ has pagado el alquiler? Se va a enfadar el casero.",
          "solucion_correcta": [
            "Todavía no/Aún no"
          ]
        },
        {
          "texto_enunciado": "—¿Ha vuelto _____ Pilar de México? —No, _____ ha vuelto.",
          "solucion_correcta": [
            "ya",
            "todavía no/aún no"
          ]
        },
        {
          "texto_enunciado": "_____ sé dónde está Viña. Me lo ha dicho Tomás.",
          "solucion_correcta": [
            "Ya"
          ]
        }
      ]
    },
    {
      "tipologia": "T7",
      "enunciado": "Rewrite the sentences with *ya*. Make the necessary changes.",
      "items": [
        {
          "texto_enunciado": "Puedes llamar a partir de ahora. _____.",
          "solucion_correcta": [
            "Puedes llamar ya"
          ]
        },
        {
          "texto_enunciado": "Dentro de unos días te llamaremos. _____.",
          "solucion_correcta": [
            "Ya te llamaremos"
          ]
        },
        {
          "texto_enunciado": "No creo que venga ahora. _____.",
          "solucion_correcta": [
            "Ya no creo que venga/No creo que venga ya"
          ]
        },
        {
          "texto_enunciado": "Te diré algo más adelante. _____.",
          "solucion_correcta": [
            "Ya te diré algo"
          ]
        },
        {
          "texto_enunciado": "¡Ahora lo entiendo! _____.",
          "solucion_correcta": [
            "¡Ya lo entiendo!"
          ]
        },
        {
          "texto_enunciado": "Hablaremos otro día. _____.",
          "solucion_correcta": [
            "Ya hablaremos"
          ]
        },
        {
          "texto_enunciado": "A partir de ahora podemos comprar las entradas. _____.",
          "solucion_correcta": [
            "Ya podemos comprar las entradas"
          ]
        },
        {
          "texto_enunciado": "Os contestaré más adelante. _____.",
          "solucion_correcta": [
            "Ya os contestaré"
          ]
        },
        {
          "texto_enunciado": "Ahora hay que irse. _____.",
          "solucion_correcta": [
            "Hay que irse ya/Ya hay que irse"
          ]
        },
        {
          "texto_enunciado": "Hará buen tiempo más adelante. _____.",
          "solucion_correcta": [
            "Ya hará buen tiempo"
          ]
        },
        {
          "texto_enunciado": "Encontrarán trabajo en el futuro. _____.",
          "solucion_correcta": [
            "Ya encontrarán trabajo"
          ]
        }
      ]
    }
  ]
}
