            "quiero"
          ]
        },
        {
          "texto_enunciado": "(I need water.) _____ agua.",
          "solucion_correcta": [
            "necesito"
          ]
        },
        {
          "texto_enunciado": "(I try to arrive early.) _____ llegar temprano.",
          "solucion_correcta": [
