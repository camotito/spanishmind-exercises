      "items": [
        {
          "texto_enunciado": "<u>Las mentiras</u> pueden ser dañinas. _____.",
          "solucion_correcta": [
            "Mentir puede ser dañino"
          ]
        },
        {
          "texto_enunciado": "<u>La vida</u> es una lucha. _____.",
          "solucion_correcta": [
            "Vivir es una lucha"
          ]
        },
        {
          "texto_enunciado": "<u>Los viajes</u> en avión son cansados. _____.",
          "solucion_correcta": [
            "Viajar en avión es cansado"
          ]
        },
        {
          "texto_enunciado": "<u>La confianza</u> en los amigos da tranquilidad. _____.",
          "solucion_correcta": [
            "Confiar en los amigos da tranquilidad"
          ]
        },
        {
          "texto_enunciado": "Me gusta <u>el baile</u>. _____.",
          "solucion_correcta": [
            "Me gusta bailar"
          ]
        },
        {
          "texto_enunciado": "A veces son necesarios <u>los cambios</u>. _____.",
          "solucion_correcta": [
            "A veces es necesario cambiar"
          ]
        },
        {
          "texto_enunciado": "Nos encantan <u>los juegos</u>. _____.",
          "solucion_correcta": [
            "Nos encanta jugar"
          ]
        }
      ]
    },
