          "solucion_correcta": [
            "Hacer ejercicio es muy sano"
          ]
        },
        {
          "texto_enunciado": "Juan llega siempre tarde. _____",
          "solucion_correcta": [
            "Raúl llega siempre muy tarde"
          ]
        },
        {
          "texto_enunciado": "Eva gasta poco. _____",
          "solucion_correcta": [
            "Eva gasta muy poco"
          ]
        }
      ]
    },
