{
  "tema": "unidad-105",
  "titulo": "muy, mucho, muchos, -ísimo...",
  "descripcion_gramatical": "Contraste entre formas de expresar grados de cualidad o cantidad",
  "fuente": "libro",
  "unidad_libro": 105,
  "ejercicios": [
    {
      "subejercicio": "105.1",
      "tipologia": "T11",
      "enunciado": "Vuelva a escribir las frases añadiendo muy o mucho.",
      "items": [
        {
          "texto_enunciado": "Esta novela es buena. _____",
          "solucion_correcta": [
            "Esta novela es muy buena"
          ]
        },
        {
          "texto_enunciado": "Esther duerme. _____",
          "solucion_correcta": [
            "Esther duerme mucho"
          ]
        },
        {
          "texto_enunciado": "Mi casa está lejos. _____",
          "solucion_correcta": [
            "Mi casa está muy lejos"
          ]
        },
        {
          "texto_enunciado": "Raúl prepara bien la carne. _____",
          "solucion_correcta": [
            "Juan prepara muy bien la carne"
          ]
        },
        {
