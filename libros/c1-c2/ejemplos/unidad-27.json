{
  "tema": "unidad-27",
  "titulo": "¡Quién fuera más joven! ¡Qué mala suerte! ¡Vaya casa!",
  "descripcion_gramatical": "Exclamativos (1)",
  "fuente": "libro",
  "unidad_libro": 27,
  "ejercicios": [
    {
      "subejercicio": "27.1",
      "tipologia": "T11",
      "enunciado": "Exprese sorpresa o deseos con *¡quién!*",
      "items": [
        {
          "texto_enunciado": "Nadie podía pensar que tendríamos un accidente. _____",
          "solucion_correcta": [
            "¡Quién iba a / podía / podría pensar que tendríamos un accidente!"
          ]
        },
        {
          "texto_enunciado": "Me gustaría hablar español como tú. _____",
          "solucion_correcta": [
            "¡Quién pudiera hablar español como tú! / ¡Quién hablara español como tú!"
          ]
        },
        {
          "texto_enunciado": "Me gustaría tener tantos amigos como Elsa. _____",
          "solucion_correcta": [
            "¡Quién tuviera tantos amigos como Elsa! / ¡Quién pudiera tener tantos amigos como Elsa!"
          ]
        },
        {
          "texto_enunciado": "Nadie se imaginaba que tendría gemelos. _____",
          "solucion_correcta": [
            "¡Quién se iba a imaginar / podía imaginarse / podría imaginarse que tendría gemelos!"
          ]
        },
        {
          "texto_enunciado": "Nadie sospechaba que Pilar nos engañaba. _____",
          "solucion_correcta": [
            "¡Quién iba a sospechar / podía sospechar /podría sospechar que Pilar nos engañaba!"
          ]
        },
        {
          "texto_enunciado": "Nadie pensaba que Ángel y Luisa salían juntos. _____",
          "solucion_correcta": [
            "¡Quién iba a pensar / podía pensar / podría pensar que Ángel y Luisa salían juntos!"
          ]
        },
        {
          "texto_enunciado": "Nadie imaginaba que Eugenio iba a jubilarse. _____",
          "solucion_correcta": [
            "¡Quién iba a imaginar / podía imaginar / podría imaginar que Eugenia se iba a jubilar!"
          ]
        }
      ]
    },
