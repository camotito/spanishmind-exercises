{
  "tema": "unidad-75",
  "titulo": "sin querer, difícil de creer",
  "descripcion_gramatical": "El infinitivo con preposiciones",
  "fuente": "libro",
  "unidad_libro": 75,
  "ejercicios": [
    {
      "subejercicio": "75.1",
      "tipologia": "T9",
      "enunciado": "Ordene las palabras entre paréntesis.",
      "items": [
        {
          "texto_enunciado": "Quieren que arreglemos la casa (ellos / regresar / antes de) _____.",
          "solucion_correcta": [
            "antes de",
            "regresar ellos"
          ]
        },
        {
          "texto_enunciado": "Gracias (haberme denunciado / no / por) _____.",
          "solucion_correcta": [
            "por",
            "no haberme denunciado"
          ]
        },
        {
          "texto_enunciado": "Eso lo hago yo (esforzarme / sin) _____.",
          "solucion_correcta": [
            "sin",
            "esforzarme"
          ]
        },
        {
          "texto_enunciado": "No te vayas a casa (hasta / haber terminado / no) _____.",
          "solucion_correcta": [
            "hasta",
            "no haber terminado"
          ]
        },
        {
          "texto_enunciado": "Me fui (Roberto / después de / haber llamado) _____.",
          "solucion_correcta": [
            "después de",
            "haber llamado Roberto"
          ]
        },
        {
          "texto_enunciado": "No os vayáis (los profesores / saberlo / sin) _____.",
          "solucion_correcta": [
            "sin",
            "saberlo los profesores"
          ]
        }
      ]
    },
    {
      "subejercicio": "75.2",
      "tipologia": "T8",
      "enunciado": "Complete con la preposición adecuada y el infinitivo simple o compuesto, afirmativa o negativa, de los verbos del recuadro.",
      "items": [
        {
          "texto_enunciado": "¡Pobre Enrique! Tiene mucho miedo _____ solo.",
          "solucion_correcta": [
            "a quedarse"
          ]
        },
        {
          "texto_enunciado": "Tenemos muchas ganas _____ con vosotros. A ver cuándo quedamos.",
          "solucion_correcta": [
            "de salir"
          ]
        },
        {
          "texto_enunciado": "Ten cuidado _____. Hace mucho frío.",
          "solucion_correcta": [
            "de no resfriarte"
          ]
        },
        {
          "texto_enunciado": "Tienes que hacer un esfuerzo _____ con Marta. Es siempre muy amable.",
          "solucion_correcta": [
            "por no enfadarte"
          ]
        },
        {
          "texto_enunciado": "No me gusta mucho la idea _____ en pisos. Es muy arriesgada.",
          "solucion_correcta": [
            "de invertir"
          ]
        },
        {
          "texto_enunciado": "Yo te conozco. Tengo la sensación _____ en alguna parte.",
          "solucion_correcta": [
            "de haberte visto"
          ]
        },
        {
          "texto_enunciado": "He venido sólo por el placer _____ un rato con vosotros. No me encontraba bien.",
          "solucion_correcta": [
            "de pasar"
          ]
        },
        {
          "texto_enunciado": "Tengo mucho interés _____ entradas para este concierto.",
          "solucion_correcta": [
            "en conseguir"
          ]
        },
        {
          "texto_enunciado": "Me dan ganas _____ a verte, pero me aguanto.",
          "solucion_correcta": [
            "de no volver"
          ]
        },
        {
          "texto_enunciado": "Tenías la obligación _____, pero no lo hiciste.",
          "solucion_correcta": [
            "de avisar"
          ]
        },
        {
          "texto_enunciado": "Luis me ha dicho que no tiene confianza _____ pronto de la cárcel.",
          "solucion_correcta": [
            "en salir"
          ]
        }
      ],
      "banco_palabras": [
        "avisar",
        "conseguir",
        "enfadarse",
        "invertir",
        "pasar",
        "quedarse",
        "resfriarse",
        "salir (2)",
        "ver",
        "volver"
      ]
    },
    {
      "subejercicio": "75.3",
      "tipologia": "T8",
      "enunciado": "Complete con la preposición adecuada y el infinitivo de los verbos del recuadro.",
      "items": [
        {
          "texto_enunciado": "Estamos cansados _____ que hay que arreglar el edificio.",
          "solucion_correcta": [
            "de decir"
          ]
        },
        {
          "texto_enunciado": "Lo que dices es difícil _____. Parece increíble.",
          "solucion_correcta": [
            "de creer"
          ]
        },
        {
          "texto_enunciado": "Rosa está decidida _____ de Agustín.",
          "solucion_correcta": [
            "a separarse"
          ]
        },
        {
          "texto_enunciado": "Eso es fácil _____. Solo hay que cambiar una pieza.",
          "solucion_correcta": [
            "de arreglar"
          ]
        },
        {
          "texto_enunciado": "Luisa está loca _____ al campo. No aguanta vivir en una ciudad.",
          "solucion_correcta": [
            "por irse"
          ]
        },
        {
          "texto_enunciado": "Creo que Isabel no está preparada _____ la obra.",
          "solucion_correcta": [
            "para dirigir"
          ]
        },
        {
          "texto_enunciado": "¿Conoces a alguien interesado _____ terrenos rústicos?",
          "solucion_correcta": [
            "en comprar"
          ]
        },
        {
          "texto_enunciado": "Lucía está resuelta _____ un diez en Lengua.",
          "solucion_correcta": [
            "a sacar"
          ]
        },
        {
          "texto_enunciado": "Luisa no es capaz _____ nada por nadie.",
          "solucion_correcta": [
            "de hacer"
          ]
        },
        {
          "texto_enunciado": "Cecilia está empeñada _____ su propio negocio.",
          "solucion_correcta": [
            "en tener"
          ]
        }
      ],
      "banco_palabras": [
        "arreglar",
        "comprar",
        "creer",
        "decir",
        "dirigir",
        "hacer",
        "irse",
        "sacar",
        "separarse",
        "tener"
      ]
    },
    {
      "subejercicio": "75.4",
      "tipologia": "T7",
      "enunciado": "Vuelva a escribir las frases subrayadas con *al* o *de*.",
      "items": [
        {
          "texto_enunciado": "Ten cuidado <u>cuando cruces la calle</u>. _____.",
          "solucion_correcta": [
            "al cruzar la calle"
          ]
        },
        {
          "texto_enunciado": "<u>Si hubiera tenido dinero</u>, te lo habría dejado. _____.",
          "solucion_correcta": [
            "De haber tenido dinero"
          ]
        },
        {
          "texto_enunciado": "<u>Si vamos a algún sitio</u> es a Toledo. _____.",
          "solucion_correcta": [
            "De ir a algún sitio"
          ]
        },
        {
          "texto_enunciado": "Me llamó <u>cuando lo supo</u>. _____.",
          "solucion_correcta": [
            "al saberlo"
          ]
        },
        {
          "texto_enunciado": "<u>Cuando vi el paraguas</u>, me di cuenta de que no era el mío _____.",
          "solucion_correcta": [
            "Al ver el paraguas"
          ]
        },
        {
          "texto_enunciado": "<u>Si puedo salir</u>, saldría el sábado. _____.",
          "solucion_correcta": [
            "De salir"
          ]
        },
        {
          "texto_enunciado": "<u>Si hubiera tenido tiempo</u>, te habría ayudado. _____.",
          "solucion_correcta": [
            "De haber tenido tiempo"
          ]
        },
        {
          "texto_enunciado": "Ten cuidado <u>cuando cortes el jamón</u>. _____.",
          "solucion_correcta": [
            "al cortar el jamón"
          ]
        }
      ]
    }
  ]
}