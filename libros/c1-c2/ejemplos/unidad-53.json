        },
        {
          "texto_enunciado": "_____ la Tierra. No tenemos otra.",
          "solucion_correcta": [
            "Salvemos"
          ]
        },
        {
          "texto_enunciado": "_____ paciencia. _____ a tomar una decisión.",
