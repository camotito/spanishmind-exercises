      "items": [
        {
          "texto_enunciado": "Es absurdo lo caros que son algunos restaurantes modernos. _____",
          "solucion_correcta": [
            "Algunos restaurantes modernos son absurdamente caros"
          ]
        },
        {
          "texto_enunciado": "Es excesivo lo temprano que es. _____",
          "solucion_correcta": [
            "Es excesivamente temprano"
          ]
        },
        {
          "texto_enunciado": "Es terrible lo lejos que está ese pueblo. _____",
          "solucion_correcta": [
            "Ese pueblo está terriblemente lejos"
          ]
        },
        {
          "texto_enunciado": "Es extraordinario lo inteligente que es tu gata. _____",
