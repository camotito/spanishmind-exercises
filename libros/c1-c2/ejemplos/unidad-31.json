        {
          "texto_enunciado": "Es verdad lo tímido que es Alfonso. _____",
          "solucion_correcta": [
            "Alfonso es verdaderamente tímido"
          ]
        },
        {
          "texto_enunciado": "Es horroroso lo maleducados que son tus hijos. _____",
          "solucion_correcta": [
            "Tus hijos son horrorosamente maleducados"
          ]
        }
      ]
    },
