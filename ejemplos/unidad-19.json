    {
      "subejercicio": "19.2",
      "tipologia": "T3",
      "enunciado": "Escriba el mío, la tuya, los suyos... según corresponda en las siguientes frases.",
      "items": [
        {
          "texto_enunciado": "Estas llaves no son mías. _____ son más pequeñas.",
          "solucion_correcta": [
            "Las mías"
          ]
        },
        {
          "texto_enunciado": "–¿Es ese vuestro coche? –No, _____ es más grande.",
          "solucion_correcta": [
            "el nuestro"
          ]
        },
        {
          "texto_enunciado": "Este abrigo no es de Pedro. _____ es azul.",
          "solucion_correcta": [
            "El suyo"
          ]
        },
        {
          "texto_enunciado": "–Perdona, ¿es éste mi asiento? –No, _____ está más atrás.",
          "solucion_correcta": [
            "el tuyo"
          ]
        },
        {
          "texto_enunciado": "–¿Es ese nuestro profesor? –No, _____ es mayor.",
          "solucion_correcta": [
            "el nuestro / el vuestro"
          ]
        },
        {
          "texto_enunciado": "–Mi deporte preferido es el fútbol. ¿Y _____? –_____ es el esquí.",
          "solucion_correcta": [
            "el tuyo",
            "El mío"
          ]
        },
        {
          "texto_enunciado": "–Mis hijos practican muchos deportes. ¿Y _____, Manuel? –_____ juegan al tenis.",
          "solucion_correcta": [
            "los tuyos",
            "Los míos"
          ]
        },
        {
          "texto_enunciado": "–¿Son esos los padres de Arturo? –No, _____ son más jóvenes.",
          "solucion_correcta": [
            "los suyos"
          ]
        },
        {
          "texto_enunciado": "–Mi profesora es peruana. –_____ es argentina.",
          "solucion_correcta": [
            "La mía"
          ]
        },
        {
          "texto_enunciado": "–Nuestros hijos son muy trabajadores. –_____ son un poco vagos.",
          "solucion_correcta": [
            "Los nuestros / Los míos"
          ]
        }
      ]
    },
