{
  "tema": "genero-palabras-no-obvias",
  "titulo": "El pan, la carne, el día [BORRADOR SIN REVISAR]",
  "descripcion_gramatical": "Género de sustantivos cuya terminación no lo indica (excepciones y patrones)",
  "ejercicios": [
    {
      "tipologia": "T5",
      "enunciado": "Choose the correct word. The ending of these nouns does not show if they are masculine or feminine: you have to learn them.",
      "items": [
        {
          "texto_enunciado": "(El/La) pan de esta panadería está muy bueno.",
          "solucion_correcta": [
            "El"
          ]
        },
        {
          "texto_enunciado": "(El/La) carne de pollo es más barata.",
          "solucion_correcta": [
            "La"
          ]
        },
        {
          "texto_enunciado": "Mañana es (el/la) día de mi cumpleaños.",
          "solucion_correcta": [
            "el"
          ]
        },
        {
          "texto_enunciado": "Me duele (el/la) mano derecha.",
          "solucion_correcta": [
            "la"
          ]
        },
        {
          "texto_enunciado": "(El/La) leche está en la nevera.",
          "solucion_correcta": [
            "La"
          ]
        },
        {
          "texto_enunciado": "(El/La) sal está en la mesa.",
          "solucion_correcta": [
            "La"
          ]
        },
        {
          "texto_enunciado": "Tengo (un/una) mapa de Madrid.",
          "solucion_correcta": [
            "un"
          ]
        },
        {
          "texto_enunciado": "Ella tiene (un/una) foto de su familia.",
          "solucion_correcta": [
            "una"
          ]
        },
        {
          "texto_enunciado": "Necesito (un/una) lápiz.",
          "solucion_correcta": [
            "un"
          ]
        },
        {
          "texto_enunciado": "Me gusta mucho (el/la) noche.",
          "solucion_correcta": [
            "la"
          ]
        }
      ]
    },
